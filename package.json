{
  "name": "dsh-voice-in",
  "version": "0.1.0",
  "type": "module",
  "description": "在聊天输入框旁边加一个麦克风：说话转文字（停顿自动断句），可选用自训练音色播报回答。",
  "keywords": ["dsh", "deepseek-harness", "cordis", "plugin", "voice", "asr", "tts"],
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "client.js", "service", "cordis.patch.yml"],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
